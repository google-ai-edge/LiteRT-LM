set(LITERTLM_SENTENCEPIECE_CONFIG_PATH "${LITERTLM_SENTENCEPIECE_PACKAGE_DIR}/sentencepiece_config.cmake")
include("${LITERTLM_SENTENCEPIECE_CONFIG_PATH}")
include("${LITERTLM_ABSL_CONFIG_PATH}")
include("${LITERTLM_PROTOBUF_CONFIG_PATH}")

include(ExternalProject)
setup_external_install_structure("${LITERTLM_SENTENCEPIECE_INSTALL_PREFIX}")

set(LITERTLM_SENTENCEPIECE_TAG "v0.2.2" CACHE STRING "Sentencepiece git tag")

  ExternalProject_Add(
    sentencepiece_external
    DEPENDS
      absl_external
      protobuf_external
    GIT_REPOSITORY https://github.com/google/sentencepiece.git
    GIT_TAG        ${LITERTLM_SENTENCEPIECE_TAG}
    PREFIX         ${LITERTLM_SENTENCEPIECE_EXT_PREFIX}
    UPDATE_COMMAND
      git fetch origin ${LITERTLM_SENTENCEPIECE_TAG}
      COMMAND git reset --hard FETCH_HEAD
      COMMAND git clean -dfx
    PATCH_COMMAND
      ${CMAKE_COMMAND}
      "-DLITERTLM_EXTERNAL_PROJECT_BIN_DIR=${LITERTLM_EXTERNAL_PROJECT_BIN_DIR}"
      "-DLITERTLM_MODULES_DIR=${LITERTLM_MODULES_DIR}"
      "-DLITERTLM_CMAKE_PACKAGES_DIR=${LITERTLM_CMAKE_PACKAGES_DIR}"
      "-DLITERTLM_TARGET_MAP_DIR=${LITERTLM_TARGET_MAP_DIR}"
      "-DLITERTLM_SENTENCEPIECE_PACKAGE_DIR=${LITERTLM_SENTENCEPIECE_PACKAGE_DIR}"
      "-DLITERTLM_SENTENCEPIECE_CONFIG_PATH=${LITERTLM_SENTENCEPIECE_CONFIG_PATH}"
      "-DLITERTLM_ABSL_PACKAGE_DIR=${LITERTLM_ABSL_PACKAGE_DIR}"
      "-DLITERTLM_ABSL_CONFIG_PATH=${LITERTLM_ABSL_CONFIG_PATH}"
      "-DLITERTLM_PROTOBUF_PACKAGE_DIR=${LITERTLM_PROTOBUF_PACKAGE_DIR}"
      "-DLITERTLM_PROTOBUF_CONFIG_PATH=${LITERTLM_PROTOBUF_CONFIG_PATH}"
      "-DLITERTLM_HOST_PROTOC_BIN_DIR=${LITERTLM_HOST_PROTOC_BIN_DIR}"
      "-DLITERTLM_HOST_PROTOC=${LITERTLM_HOST_PROTOC}"
      "-P ${LITERTLM_SENTENCEPIECE_PACKAGE_DIR}/sentencepiece_patcher.cmake"

    CONFIGURE_COMMAND
      ${CMAKE_COMMAND} -E env CC=${CMAKE_C_COMPILER} CXX=${CMAKE_CXX_COMPILER}
      ${CMAKE_COMMAND} -S ${LITERTLM_SENTENCEPIECE_SRC_DIR} -B ${LITERTLM_SENTENCEPIECE_BUILD_DIR}
      ${LITERTLM_TOOLCHAIN_FILE}
      ${LITERTLM_TOOLCHAIN_ARGS}
      "-DLITERTLM_ORCHESTRATION_PHASE=${LITERTLM_ORCHESTRATION_PHASE}"
      "-DLITERTLM_BIN_EXT=${LITERTLM_BIN_EXT}"
      "-DLITERTLM_STATIC_LIB_EXT=${LITERTLM_STATIC_LIB_EXT}"
      "-DLITERTLM_DYN_LIB_EXT=${LITERTLM_DYN_LIB_EXT}"
      "-DLITERTLM_LIB_PREFIX=${LITERTLM_LIB_PREFIX}"
      "-DLITERTLM_EXTERNAL_PROJECT_BIN_DIR=${LITERTLM_EXTERNAL_PROJECT_BIN_DIR}"
      "-DLITERTLM_MODULES_DIR=${LITERTLM_MODULES_DIR}"
      "-DLITERTLM_CMAKE_PACKAGES_DIR=${LITERTLM_CMAKE_PACKAGES_DIR}"
      "-DLITERTLM_TARGET_MAP_DIR=${LITERTLM_TARGET_MAP_DIR}"
      "-DLITERTLM_SENTENCEPIECE_PACKAGE_DIR=${LITERTLM_SENTENCEPIECE_PACKAGE_DIR}"
      "-DLITERTLM_SENTENCEPIECE_CONFIG_PATH=${LITERTLM_SENTENCEPIECE_CONFIG_PATH}"
      "-DLITERTLM_ABSL_PACKAGE_DIR=${LITERTLM_ABSL_PACKAGE_DIR}"
      "-DLITERTLM_ABSL_CONFIG_PATH=${LITERTLM_ABSL_CONFIG_PATH}"
      "-DLITERTLM_PROTOBUF_PACKAGE_DIR=${LITERTLM_PROTOBUF_PACKAGE_DIR}"
      "-DLITERTLM_PROTOBUF_CONFIG_PATH=${LITERTLM_PROTOBUF_CONFIG_PATH}"
      "-DLITERTLM_HOST_PROTOC_BIN_DIR=${LITERTLM_HOST_PROTOC_BIN_DIR}"
      "-DLITERTLM_HOST_PROTOC=${LITERTLM_HOST_PROTOC}"


      "-DCMAKE_INSTALL_PREFIX=${LITERTLM_SENTENCEPIECE_INSTALL_PREFIX}"
      "-DCMAKE_INSTALL_LIBDIR=lib"
      "-DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}"
      "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
      "-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}"
      "-DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}"
      "-DCMAKE_CXX_STANDARD=${CMAKE_CXX_STANDARD}"
      "-DCMAKE_CXX_STANDARD_REQUIRED=ON"
      "-DCMAKE_POSITION_INDEPENDENT_CODE=ON"
      "-DCMAKE_PREFIX_PATH=${LITERTLM_ABSL_INSTALL_PREFIX};${LITERTLM_PROTOBUF_INSTALL_PREFIX}"

      "-DSPM_ABSL_PROVIDER=package"
      "-DSPM_PROTOBUF_PROVIDER=package"
      "-DSPM_ENABLE_SHARED=OFF"
      "-DSPM_ENABLE_TCMALLOC=OFF"

      "-Dabsl_DIR=${LITERTLM_ABSL_INSTALL_PREFIX}/lib/cmake/absl"
      "-DABSL_INCLUDE_DIRS=${LITERTLM_ABSL_INCLUDE_DIR}"
      "-DABSL_INCLUDE_DIR=${LITERTLM_ABSL_INCLUDE_DIR}"
      "-DABSL_SRC_DIR=${LITERTLM_ABSL_SRC_DIR}"
      "-DABSL_LIB_DIR=${LITERTLM_ABSL_LIB_DIR}"
      "-DABSL_PACKAGE_DIR=${LITERTLM_ABSL_PACKAGE_DIR}"

      "-DProtobuf_DIR=${LITERTLM_PROTOBUF_INSTALL_PREFIX}/lib/cmake/protobuf"
      "-DProtobuf_LIBRARIES=${LITERTLM_PROTOBUF_LIB_DIR}"
      "-DProtobuf_INCLUDE_DIR=${LITERTLM_PROTOBUF_INCLUDE_DIR}"
      "-DProtobuf_PROTOC_EXECUTABLE=${LITERTLM_HOST_PROTOC}"
      "-DProtobuf_LITE_LIBRARY=${LITERTLM_PROTOBUF_LIB_DIR}/libprotobuf.a"
      "-DProtobuf_PROTOC_LIBRARY_DEBUG="
      "-DProtobuf_PROTOC_LIBRARY_RELEASE="
      "-DPROTO_PROTOC_EXECUTABLE=${LITERTLM_HOST_PROTOC}"
      "-DPROTO_INCLUDE_DIR=${LITERTLM_PROTOBUF_INCLUDE_DIR}"
      "-DPROTOBUF_PACKAGE_DIR=${LITERTLM_PROTOBUF_PACKAGE_DIR}"
      "-DPROTO_LIB_DIR=${LITERTLM_PROTOBUF_LIB_DIR}"
      "-DPROTO_SRC_DIR=${LITERTLM_PROTOBUF_SRC_DIR}"

  )
  if(LITERTLM_GENERATE_TARGET_MAP)
    ExternalProject_Add_Step(sentencepiece_external generate_target_map
        COMMAND ${CMAKE_COMMAND}
            "-DDEP_NAME=sentencepiece"
            "-DSEARCH_DIR=${LITERTLM_SENTENCEPIECE_LIB_DIR}"
            "-DSEARCH_STR=LITERTLM_SENTENCEPIECE_LIB_DIR"
            "-DOUTPUT_FILE=${LITERTLM_SENTENCEPIECE_TARGET_MAP_PATH}"
            -P ${LITERTLM_SCRIPTS_DIR}/generate_target_map.cmake
        DEPENDEES install
        BYPRODUCTS ${LITERTLM_SENTENCEPIECE_TARGET_MAP_PATH}
    )
  endif()
  if(NOT TARGET sentencepiece_external)
    add_custom_target(sentencepiece_external)
  endif()

include(${LITERTLM_SENTENCEPIECE_AGGREGATE_PATH})
generate_sentencepiece_aggregate()
