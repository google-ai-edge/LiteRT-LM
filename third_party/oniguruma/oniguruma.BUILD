# Bazel build file for Oniguruma (https://github.com/kkos/oniguruma), the
# regular expression engine used by the HuggingFace tokenizers port in
# //support/tokenizer/tokenizers. Mirrors the
# upstream CMake build with BUILD_SHARED_LIBS=OFF and ENABLE_POSIX_API=OFF.

load("@bazel_skylib//rules:write_file.bzl", "write_file")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])  # BSD-2-Clause

exports_files(["COPYING"])

# Replaces the autoconf/CMake generated config.h. Only the macros that the
# sources actually test are defined; the integer sizes are derived from
# compiler built-ins so that one file works for 32/64-bit targets and for
# LLP64 (Windows, where `long` is 4 bytes).
write_file(
    name = "config_h",
    out = "src/config.h",
    content = [
        "/* Generated by oniguruma.BUILD (LiteRT-LM). */",
        "#ifndef ONIGURUMA_LITERT_LM_CONFIG_H_",
        "#define ONIGURUMA_LITERT_LM_CONFIG_H_",
        "#define HAVE_STDINT_H 1",
        "#define HAVE_SYS_TYPES_H 1",
        "#if !defined(_WIN32)",
        "#define HAVE_ALLOCA_H 1",
        "#endif",
        "#define SIZEOF_INT 4",
        "#define SIZEOF_LONG_LONG 8",
        "#if defined(_WIN32) || (defined(__SIZEOF_LONG__) && __SIZEOF_LONG__ == 4)",
        "#define SIZEOF_LONG 4",
        "#else",
        "#define SIZEOF_LONG 8",
        "#endif",
        "#if defined(__SIZEOF_POINTER__)",
        "#define SIZEOF_VOIDP __SIZEOF_POINTER__",
        "#elif defined(_WIN64) || defined(__LP64__)",
        "#define SIZEOF_VOIDP 8",
        "#else",
        "#define SIZEOF_VOIDP 4",
        "#endif",
        "#endif  /* ONIGURUMA_LITERT_LM_CONFIG_H_ */",
    ],
)

cc_library(
    name = "oniguruma",
    srcs = [
        "src/ascii.c",
        "src/big5.c",
        "src/config.h",
        "src/cp1251.c",
        "src/euc_jp.c",
        "src/euc_jp_prop.c",
        "src/euc_kr.c",
        "src/euc_tw.c",
        "src/gb18030.c",
        "src/iso8859_1.c",
        "src/iso8859_10.c",
        "src/iso8859_11.c",
        "src/iso8859_13.c",
        "src/iso8859_14.c",
        "src/iso8859_15.c",
        "src/iso8859_16.c",
        "src/iso8859_2.c",
        "src/iso8859_3.c",
        "src/iso8859_4.c",
        "src/iso8859_5.c",
        "src/iso8859_6.c",
        "src/iso8859_7.c",
        "src/iso8859_8.c",
        "src/iso8859_9.c",
        "src/koi8_r.c",
        "src/onig_init.c",
        "src/regcomp.c",
        "src/regenc.c",
        "src/regenc.h",
        "src/regerror.c",
        "src/regexec.c",
        "src/regext.c",
        "src/reggnu.c",
        "src/regint.h",
        "src/regparse.c",
        "src/regparse.h",
        "src/regsyntax.c",
        "src/regtrav.c",
        "src/regversion.c",
        "src/sjis.c",
        "src/sjis_prop.c",
        "src/st.c",
        "src/st.h",
        "src/unicode.c",
        "src/unicode_fold1_key.c",
        "src/unicode_fold2_key.c",
        "src/unicode_fold3_key.c",
        "src/unicode_unfold_key.c",
        "src/utf16_be.c",
        "src/utf16_le.c",
        "src/utf32_be.c",
        "src/utf32_le.c",
        "src/utf8.c",
    ],
    hdrs = [
        "src/oniggnu.h",
        "src/oniguruma.h",
    ],
    copts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-Wno-pointer-to-int-cast"],
    }),
    # Static library: without ONIG_STATIC oniguruma.h declares the API with
    # __declspec(dllimport) on MSVC.
    defines = ["ONIG_STATIC"],
    includes = ["src"],
    textual_hdrs = [
        "src/unicode_egcb_data.c",
        "src/unicode_fold_data.c",
        "src/unicode_property_data.c",
        "src/unicode_wb_data.c",
    ],
)
