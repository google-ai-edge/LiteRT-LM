+def _materialize_manifest_runfiles(runfiles_root, main_rel_path, delete_dirs):
+  """Provides the normal runfiles layout without Windows symlink privilege."""
+  if not IS_WINDOWS or os.path.exists(join(runfiles_root, main_rel_path)):
+    return runfiles_root
+  manifest = runfiles_root + '_manifest'
+  if not os.path.isfile(manifest):
+    return runfiles_root
+  import tempfile
+  temporary = tempfile.mkdtemp(prefix='Bazel.runfiles_manifest_')
+  copied_root = join(temporary, 'runfiles')
+  os.makedirs(copied_root)
+  # Only this freshly created private directory is registered for cleanup.
+  delete_dirs.append(temporary)
+  with open(manifest, encoding='utf-8') as stream:
+    for line in stream:
+      line = line.rstrip('\n')
+      escaped = line.startswith(' ')
+      if escaped:
+        line = line[1:]
+      name, separator, target = line.partition(' ')
+      if not separator:
+        target = name
+      if escaped:
+        name = name.replace(r'\s', ' ').replace(r'\n', '\n').replace(r'\b', '\\')
+        target = target.replace(r'\n', '\n').replace(r'\b', '\\')
+      destination = abspath(join(copied_root, name))
+      if os.path.commonpath([copied_root, destination]) != copied_root:
+        raise ValueError('Runfiles entry escapes private root: ' + name)
+      os.makedirs(dirname(destination), exist_ok=True)
+      destination = get_windows_path_with_unc_prefix(destination)
+      if not target:
+        open(destination, 'wb').close()
+      elif os.path.isdir(get_windows_path_with_unc_prefix(target)):
+        shutil.copytree(get_windows_path_with_unc_prefix(target), destination, dirs_exist_ok=True)
+      else:
+        shutil.copyfile(get_windows_path_with_unc_prefix(target), destination)
+  os.environ.pop('RUNFILES_MANIFEST_FILE', None)
+  os.environ.pop('RUNFILES_MANIFEST_ONLY', None)
+  os.environ['RUNFILES_DIR'] = copied_root
+  return copied_root
+
+
