# proto-file: runtime/proto/llm_metadata.proto
# proto-message: LlmMetadata
start_token {
  token_str: "<bos>"
}
stop_tokens {
  token_ids {
    ids: 1
  }
}
stop_tokens {
  token_ids {
    ids: 106
  }
}
stop_tokens {
  token_ids {
    ids: 50
  }
}
sampler_params {
  type: TOP_P
  k: 64
  p: 0.95
  temperature: 1.0
}
max_num_tokens: 128021
channels {
  channel_name: "thought"
  start: "<|channel>thought\n"
  end: "<channel|>"
}
suppress_tokens {
  ids: 258883
  ids: 258882
}
llm_model_type {
  gemma4 {
    start_of_image_token {
      token_str: "<|image>"
    }
    end_of_image_token {
      token_str: "<image|>"
    }
    patch_width: 16
    patch_height: 16
    pooling_kernel_size: 3
    max_num_patches: 10080
    merge_patches: true
    start_of_audio_token {
      token_str: "<|audio>"
    }
    end_of_audio_token {
      token_str: "<audio|>"
    }
    code_fence_start: "<|tool_call>"
    code_fence_end: "<tool_call|>"
    open_quote: "<|\"|>"
    close_quote: "<|\"|>"
    function_response_start: "<|tool_response>"
    use_template_for_fc_format: true
    skip_mel_spectrogram_extraction: true
  }
}
prompt_templates {
  user {
    prefix: "<|turn>user\n"
    suffix: "<turn|>\n"
  }
  model {
    prefix: "<|turn>model\n"
    suffix: "<turn|>\n"
  }
}
jinja_prompt_template:
  "{%- macro format_parameters(properties) -%}\n"
  "    {%- for key, value in properties | dictsort -%}\n"
  "        {%- set add_comma = false -%}\n"
  "        {%- if not loop.first %},{% endif -%}\n"
  "        {{ key }}:{\n"
  "            {%- if value['description'] -%}\n"
  "                description:<|\"|>{{ value['description'] }}<|\"|>\n"
  "                {%- set add_comma = true -%}\n"
  "            {%- endif -%}\n"
  "            {%- if value['nullable'] %}\n"
  "                {%- if add_comma %},{%- else -%} {%- set add_comma = true -%} {% endif -%}\n"
  "                nullable:true\n"
  "            {%- endif -%}\n"
  "            {%- if value['type'] | upper == 'STRING' -%}\n"
  "                {%- if value['enum'] -%}\n"
  "                    {%- if add_comma %},{%- else -%} {%- set add_comma = true -%} {% endif -%}\n"
  "                    enum:{{ format_argument(value['enum']) }}\n"
  "                {%- endif -%}\n"
  "            {%- elif value['type'] | upper == 'OBJECT' -%}\n"
  "                ,properties:{\n"
  "                {%- if value['properties'] is defined and value['properties'] is mapping -%}\n"
  "                    {{- format_parameters(value['properties']) -}}\n"
  "                {%- elif value is mapping -%}\n"
  "                    {{- format_parameters(value) -}}\n"
  "                {%- endif -%}\n"
  "                }\n"
  "                {%- if value['required'] -%}\n"
  "                    ,required:{{ format_argument(value['required']) }}\n"
  "                {%- endif -%}\n"
  "            {%- elif value['type'] | upper == 'ARRAY' -%}\n"
  "                {%- if value['items'] is mapping and value['items'] -%}\n"
  "                    ,items:{\n"
  "                    {%- for item_key, item_value in value['items'] | dictsort if item_value is not none -%}\n"
  "                        {%- if not loop.first %},{% endif -%}\n"
  "                        {%- if item_key == 'properties' -%}\n"
  "                            properties:{\n"
  "                            {%- if item_value is mapping -%}\n"
  "                                {{- format_parameters(item_value) -}}\n"
  "                            {%- endif -%}\n"
  "                            }\n"
  "                        {%- elif item_key == 'type' -%}\n"
  "                            {%- if item_value is string -%}\n"
  "                                type:{{ format_argument(item_value | upper) }}\n"
  "                            {%- else -%}\n"
  "                                type:{{ format_argument(item_value | map('upper') | list) }}\n"
  "                            {%- endif -%}\n"
  "                        {%- else -%}\n"
  "                            {{ item_key }}:{{ format_argument(item_value) }}\n"
  "                        {%- endif -%}\n"
  "                    {%- endfor -%}\n"
  "                    }\n"
  "                {%- endif -%}\n"
  "            {%- endif -%}\n"
  "            {%- if add_comma %},{%- else -%} {%- set add_comma = true -%} {% endif -%}\n"
  "            type:<|\"|>{{ value['type'] | upper }}<|\"|>}\n"
  "    {%- endfor -%}\n"
  "{%- endmacro -%}\n"
  "\n"
  "{%- macro format_function_declaration(tool_data) -%}\n"
  "    declaration:{{- tool_data['function']['name'] -}}{description:<|\"|>{{- tool_data['function']['description'] -}}<|\"|>\n"
  "    {%- set params = tool_data['function']['parameters'] -%}\n"
  "    {%- if params -%}\n"
  "        ,parameters:{\n"
  "        {%- if params['properties'] -%}\n"
  "            properties:{ {{- format_parameters(params['properties']) -}} },\n"
  "        {%- endif -%}\n"
  "        {%- if params['required'] -%}\n"
  "            required:{{ format_argument(params['required']) }},\n"
  "        {%- endif -%}\n"
  "        {%- if params['type'] -%}\n"
  "            type:<|\"|>{{- params['type'] | upper -}}<|\"|>}\n"
  "        {%- endif -%}\n"
  "    {%- endif -%}\n"
  "    {%- if 'response' in tool_data['function'] -%}\n"
  "        {%- set response_declaration = tool_data['function']['response'] -%}\n"
  "        ,response:{\n"
  "        {%- if response_declaration['description'] -%}\n"
  "            description:<|\"|>{{- response_declaration['description'] -}}<|\"|>,\n"
  "        {%- endif -%}\n"
  "        {%- if response_declaration['type'] | upper == 'OBJECT' -%}\n"
  "            type:<|\"|>{{- response_declaration['type'] | upper -}}<|\"|>}\n"
  "        {%- endif -%}\n"
  "    {%- endif -%}\n"
  "    }\n"
  "{%- endmacro -%}\n"
  "\n"
  "{%- macro format_argument(argument, escape_keys=True) -%}\n"
  "    {%- if argument is string -%}\n"
  "        {{- '<|\"|>' + argument + '<|\"|>' -}}\n"
  "    {%- elif argument is boolean -%}\n"
  "        {{- 'true' if argument else 'false' -}}\n"
  "    {%- elif argument is mapping -%}\n"
  "        {{- '{' -}}\n"
  "        {%- for key, value in argument | dictsort -%}\n"
  "            {%- if not loop.first %},{% endif -%}\n"
  "            {{- ('<|\"|>' + key + '<|\"|>') if escape_keys else key -}}:{{- format_argument(value, escape_keys=escape_keys) -}}\n"
  "        {%- endfor -%}\n"
  "        {{- '}' -}}\n"
  "    {%- elif argument is sequence -%}\n"
  "        {{- '[' -}}\n"
  "        {%- for item in argument -%}\n"
  "            {{- format_argument(item, escape_keys=escape_keys) -}}\n"
  "            {%- if not loop.last %},{% endif -%}\n"
  "        {%- endfor -%}\n"
  "        {{- ']' -}}\n"
  "    {%- else -%}\n"
  "        {{- argument -}}\n"
  "    {%- endif -%}\n"
  "{%- endmacro -%}\n"
  "\n"
  "{%- macro format_content(content) -%}\n"
  "    {%- if content is string -%}\n"
  "        {{- content | trim -}}\n"
  "    {%- elif content is sequence -%}\n"
  "        {%- for item in content -%}\n"
  "            {%- if item['type'] == 'text' -%}\n"
  "                {{- item['text'] | trim -}}\n"
  "            {%- elif item['type'] == 'image' -%}\n"
  "                {{- '\\n\\n<|image|>\\n\\n' -}}\n"
  "            {%- elif item['type'] == 'audio' -%}\n"
  "                {{- '<|audio|>' -}}\n"
  "            {%- endif -%}\n"
  "        {%- endfor -%}\n"
  "    {%- endif -%}\n"
  "{%- endmacro -%}\n"
  "\n"
  "{%- set thinking = enable_thinking | default(false) -%}\n"
  "{%- set ns = namespace(prev_message_type=None) -%}\n"
  "{%- set loop_messages = messages -%}\n"
  "{{ bos_token }}\n"
  "{#- Handle System/Tool Definitions Block -#}\n"
  "{%- if thinking or tools or messages[0]['role'] == 'system' -%}\n"
  "    {{- '<|turn>system' -}}\n"
  "\n"
  "    {#- Inject Thinking token at the very top of the FIRST system turn -#}\n"
  "    {%- if thinking -%}\n"
  "        {{- '\\n<|think|>' -}}\n"
  "    {%- endif -%}\n"
  "\n"
  "    {%- if messages[0]['role'] == 'system' -%}\n"
  "        {{- '\\n' + format_content(messages[0]['content']) -}}\n"
  "        {%- set loop_messages = messages[1:] -%}\n"
  "    {%- endif -%}\n"
  "\n"
  "    {%- if tools -%}\n"
  "        {{- '\\n' -}}\n"
  "        {%- for tool in tools %}\n"
  "            {{- '<|tool>' -}}\n"
  "            {{- format_function_declaration(tool) | trim -}}\n"
  "            {{- '<tool|>' -}}\n"
  "        {%- endfor %}\n"
  "    {%- endif -%}\n"
  "\n"
  "    {{- '<turn|>\\n' -}}\n"
  "{%- endif %}\n"
  "\n"
  "{#- Loop through messages -#}\n"
  "{%- for message in loop_messages -%}\n"
  "    {%- set role = 'model' if message['role'] == 'assistant' else message['role'] -%}\n"
  "    {%- if role != 'tool' -%}\n"
  "        {%- if not (role == 'model' and ns.prev_message_type == 'tool_response') -%}\n"
  "            {{- '<|turn>' + role + '\\n' }}\n"
  "        {%- endif -%}\n"
  "    {%- endif -%}\n"
  "\n"
  "    {%- if message['tool_calls'] -%}\n"
  "        {%- for tool_call in message['tool_calls'] -%}\n"
  "            {%- set function = tool_call['function'] -%}\n"
  "            {{- '<|tool_call>call:' + function['name'] + format_argument(function['arguments'], escape_keys=False) + '<tool_call|>' -}}\n"
  "        {%- endfor -%}\n"
  "        {%- set ns.prev_message_type = 'tool_call' -%}\n"
  "    {%- endif -%}\n"
  "\n"
  "    {%- if role == 'tool' and message['content'] is sequence -%}\n"
  "        {#- Tool Response handling -#}\n"
  "        {%- for item in message['content'] -%}\n"
  "            {{- '<|tool_response>response:' + item['name'] | default('unknown') -}}\n"
  "            {%- if item['response'] is mapping -%}\n"
  "                {{- format_argument(item['response'], escape_keys=False) -}}\n"
  "            {%- else -%}\n"
  "                {{- '{value:' + format_argument(item['response'], escape_keys=False) + '}' -}}\n"
  "            {%- endif -%}\n"
  "            {{- '<tool_response|>' -}}\n"
  "        {%- endfor -%}\n"
  "        {%- set ns.prev_message_type = 'tool_response' -%}\n"
  "    {%- else -%}\n"
  "        {{- format_content(message['content']) -}}\n"
  "        {%- if not message['tool_calls'] -%}\n"
  "            {%- set ns.prev_message_type = None -%}\n"
  "        {%- endif -%}\n"
  "    {%- endif -%}\n"
  "\n"
  "    {%- if ns.prev_message_type == None -%}\n"
  "        {{- '<turn|>\\n' -}}\n"
  "    {%- endif -%}\n"
  "{%- endfor -%}\n"
  "\n"
  "{%- if add_generation_prompt -%}\n"
  "    {%- if ns.prev_message_type != 'tool_response' and ns.prev_message_type != 'tool_call' -%}\n"
  "        {{- '<|turn>model\\n' -}}\n"
  "        {%- if not thinking -%}\n"
  "            {{- '<|channel>thought\\n<channel|>' -}}\n"
  "        {%- endif -%}\n"
  "    {%- elif ns.prev_message_type == 'tool_response' and thinking -%}\n"
  "        {{- '<|channel>thought\\n' -}}\n"
  "    {%- endif -%}\n"
  "{%- endif -%}\n"
  ""
