# proto-file: runtime/proto/llm_metadata.proto
# proto-message: LlmMetadataProto

start_token {
  token_str: "<|startoftext|>"
}
stop_tokens {
  token_str: "<|im_end|>"
}
stop_tokens {
  token_str: "<|endoftext|>"
}
sampler_params {
  type: TOP_P
  k: 50
  p: 0.9
  temperature: 0.7
}
max_num_tokens: 4096
llm_model_type {
  lfm2 {
  }
}
supports_function_calling: true
jinja_prompt_template: "{%- macro format_arg_value(arg_value) -%}\n    {%- if arg_value is boolean -%}\n        {{- 'true' if arg_value else 'false' -}}\n    {%- elif arg_value is string or arg_value is mapping or arg_value is sequence -%}\n        {{- arg_value | tojson -}}\n    {%- else -%}\n        {{- arg_value | string -}}\n    {%- endif -%}\n{%- endmacro -%}\n\n{%- macro format_content(content) -%}\n    {%- if content is string -%}\n        {{- content -}}\n    {%- elif content is mapping -%}\n        {{- content | tojson -}}\n    {%- elif content is sequence -%}\n        {%- for item in content -%}\n            {%- if item is string -%}\n                {{- item -}}\n            {%- elif item['type'] == 'text' -%}\n                {{- item['text'] -}}\n            {%- elif item['type'] == 'tool_response' -%}\n                {%- if item['response'] is mapping or item['response'] is sequence -%}\n                    {{- item['response'] | tojson -}}\n                {%- else -%}\n                    {{- item['response'] | string -}}\n                {%- endif -%}\n            {%- else -%}\n                {{- item | tojson -}}\n            {%- endif -%}\n        {%- endfor -%}\n    {%- endif -%}\n{%- endmacro -%}\n\n{%- macro format_tool_content(content) -%}\n    {%- if not content -%}\n        {{- '' -}}\n    {%- elif content is string -%}\n        {%- set trimmed = content | trim -%}\n        {%- if trimmed.startswith('[') and trimmed.endswith(']') -%}\n            {{- trimmed -}}\n        {%- else -%}\n            {{- '[' + trimmed + ']' -}}\n        {%- endif -%}\n    {%- elif content is mapping -%}\n        {{- '[' + (content | tojson) + ']' -}}\n    {%- elif content is sequence -%}\n        {%- set resp_ns = namespace(items=[]) -%}\n        {%- for item in content -%}\n            {%- if item is mapping and 'type' in item and item['type'] == 'tool_response' -%}\n                {%- set resp_val = item['response'] if 'response' in item else item -%}\n                {%- if resp_val is mapping or resp_val is sequence -%}\n                    {%- set resp_ns.items = resp_ns.items + [resp_val | tojson] -%}\n                {%- else -%}\n                    {%- set resp_ns.items = resp_ns.items + [resp_val | string] -%}\n                {%- endif -%}\n            {%- elif item is mapping or item is sequence -%}\n                {%- set resp_ns.items = resp_ns.items + [item | tojson] -%}\n            {%- else -%}\n                {%- set resp_ns.items = resp_ns.items + [item | string] -%}\n            {%- endif -%}\n        {%- endfor -%}\n        {%- set joined = resp_ns.items | join(', ') | trim -%}\n        {%- if joined.startswith('[') and joined.endswith(']') -%}\n            {{- joined -}}\n        {%- else -%}\n            {{- '[' + joined + ']' -}}\n        {%- endif -%}\n    {%- else -%}\n        {{- '[' + (content | string) + ']' -}}\n    {%- endif -%}\n{%- endmacro -%}\n\n{%- macro render_tool_calls(tool_calls) -%}\n    {%- set tool_calls_ns = namespace(tool_calls=[]) -%}\n    {%- for tool_call in tool_calls -%}\n        {%- set func = tool_call['function'] if 'function' in tool_call else tool_call -%}\n        {%- set func_name = func['name'] -%}\n        {%- set func_args = func['arguments'] -%}\n        {%- set args_ns = namespace(arg_strings=[]) -%}\n        {%- if func_args is mapping -%}\n            {%- for arg_name, arg_value in func_args | dictsort -%}\n                {%- set args_ns.arg_strings = args_ns.arg_strings + [arg_name + '=' + format_arg_value(arg_value)] -%}\n            {%- endfor -%}\n        {%- elif func_args is string and (func_args | trim) not in ['', '{}', 'null'] -%}\n            {{- raise_exception('Tool call arguments must be a mapping, got a JSON-encoded string') -}}\n        {%- endif -%}\n        {%- set tool_calls_ns.tool_calls = tool_calls_ns.tool_calls + [func_name + '(' + (args_ns.arg_strings | join(', ')) + ')'] -%}\n    {%- endfor -%}\n    {{- '<|tool_call_start|>[' + (tool_calls_ns.tool_calls | join(', ')) + ']<|tool_call_end|>' -}}\n{%- endmacro -%}\n\n{%- set is_first_system = messages[0]['role'] == 'system' -%}\n{%- set loop_messages = messages[1:] if is_first_system else messages -%}\n{%- set system_content = format_content(messages[0]['content']) if is_first_system and messages[0]['content'] else '' -%}\n{%- if tools -%}\n    {%- set tools_ns = namespace(tool_strings=[]) -%}\n    {%- for tool in tools -%}\n        {%- set tool_data = tool['function'] if tool is mapping and 'function' in tool else tool -%}\n        {%- set tool_str = tool_data if tool_data is string else tool_data | tojson -%}\n        {%- set tools_ns.tool_strings = tools_ns.tool_strings + [tool_str] -%}\n    {%- endfor -%}\n    {%- set tools_block = 'List of tools: [' + (tools_ns.tool_strings | join(', ')) + ']' -%}\n    {%- set system_content = (system_content + '\\n' if system_content else '') + tools_block -%}\n{%- endif -%}\n{%- if system_content -%}\n    {{- '<|im_start|>system\\n' + system_content + '<|im_end|>\\n' -}}\n{%- endif -%}\n\n{%- for message in loop_messages -%}\n    {%- if message['role'] == 'assistant' -%}\n        {{- '<|im_start|>assistant\\n' -}}\n        {%- set thinking = message['thinking'] | default(message['reasoning_content'] | default('')) -%}\n        {%- if thinking -%}\n            {{- '<think>' + thinking + '</think>' -}}\n        {%- endif -%}\n        {%- if message['tool_calls'] -%}\n            {{- render_tool_calls(message['tool_calls']) -}}\n        {%- endif -%}\n        {{- format_content(message['content']) -}}\n        {{- '<|im_end|>\\n' -}}\n    {%- elif message['role'] == 'tool' -%}\n        {{- '<|im_start|>tool\\n' + format_tool_content(message['content']) + '<|im_end|>\\n' -}}\n    {%- else -%}\n        {{- '<|im_start|>' + message['role'] + '\\n' + format_content(message['content']) + '<|im_end|>\\n' -}}\n    {%- endif -%}\n{%- endfor -%}\n\n{%- if add_generation_prompt -%}\n    {{- '<|im_start|>assistant\\n' -}}\n    {%- if enable_thinking | default(false) -%}\n        {{- '<think>\\n' -}}\n    {%- endif -%}\n{%- endif -%}\n"

channels {
  channel_name: "thought"
  start: "<think>\n"
  end: "</think>"
}
