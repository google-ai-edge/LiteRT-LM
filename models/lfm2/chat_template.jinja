{%- macro format_arg_value(arg_value) -%}
    {%- if arg_value is boolean -%}
        {{- 'true' if arg_value else 'false' -}}
    {%- elif arg_value is string or arg_value is mapping or arg_value is sequence -%}
        {{- arg_value | tojson -}}
    {%- else -%}
        {{- arg_value | string -}}
    {%- endif -%}
{%- endmacro -%}

{%- macro format_content(content) -%}
    {%- if content is string -%}
        {{- content -}}
    {%- elif content is mapping -%}
        {{- content | tojson -}}
    {%- elif content is sequence -%}
        {%- for item in content -%}
            {%- if item is string -%}
                {{- item -}}
            {%- elif item['type'] == 'text' -%}
                {{- item['text'] -}}
            {%- elif item['type'] == 'tool_response' -%}
                {%- if item['response'] is mapping or item['response'] is sequence -%}
                    {{- item['response'] | tojson -}}
                {%- else -%}
                    {{- item['response'] | string -}}
                {%- endif -%}
            {%- else -%}
                {{- item | tojson -}}
            {%- endif -%}
        {%- endfor -%}
    {%- endif -%}
{%- endmacro -%}

{%- macro format_tool_content(content) -%}
    {%- if not content -%}
        {{- '' -}}
    {%- elif content is string -%}
        {%- set trimmed = content | trim -%}
        {%- if trimmed.startswith('[') and trimmed.endswith(']') -%}
            {{- trimmed -}}
        {%- else -%}
            {{- '[' + trimmed + ']' -}}
        {%- endif -%}
    {%- elif content is mapping -%}
        {{- '[' + (content | tojson) + ']' -}}
    {%- elif content is sequence -%}
        {%- set resp_ns = namespace(items=[]) -%}
        {%- for item in content -%}
            {%- if item is mapping and 'type' in item and item['type'] == 'tool_response' -%}
                {%- set resp_val = item['response'] if 'response' in item else item -%}
                {%- if resp_val is mapping or resp_val is sequence -%}
                    {%- set resp_ns.items = resp_ns.items + [resp_val | tojson] -%}
                {%- else -%}
                    {%- set resp_ns.items = resp_ns.items + [resp_val | string] -%}
                {%- endif -%}
            {%- elif item is mapping or item is sequence -%}
                {%- set resp_ns.items = resp_ns.items + [item | tojson] -%}
            {%- else -%}
                {%- set resp_ns.items = resp_ns.items + [item | string] -%}
            {%- endif -%}
        {%- endfor -%}
        {%- set joined = resp_ns.items | join(', ') | trim -%}
        {%- if joined.startswith('[') and joined.endswith(']') -%}
            {{- joined -}}
        {%- else -%}
            {{- '[' + joined + ']' -}}
        {%- endif -%}
    {%- else -%}
        {{- '[' + (content | string) + ']' -}}
    {%- endif -%}
{%- endmacro -%}

{%- macro render_tool_calls(tool_calls) -%}
    {%- set tool_calls_ns = namespace(tool_calls=[]) -%}
    {%- for tool_call in tool_calls -%}
        {%- set func = tool_call['function'] if 'function' in tool_call else tool_call -%}
        {%- set func_name = func['name'] -%}
        {%- set func_args = func['arguments'] -%}
        {%- set args_ns = namespace(arg_strings=[]) -%}
        {%- if func_args is mapping -%}
            {%- for arg_name, arg_value in func_args | dictsort -%}
                {%- set args_ns.arg_strings = args_ns.arg_strings + [arg_name + '=' + format_arg_value(arg_value)] -%}
            {%- endfor -%}
        {%- elif func_args is string and (func_args | trim) not in ['', '{}', 'null'] -%}
            {{- raise_exception('Tool call arguments must be a mapping, got a JSON-encoded string') -}}
        {%- endif -%}
        {%- set tool_calls_ns.tool_calls = tool_calls_ns.tool_calls + [func_name + '(' + (args_ns.arg_strings | join(', ')) + ')'] -%}
    {%- endfor -%}
    {{- '<|tool_call_start|>[' + (tool_calls_ns.tool_calls | join(', ')) + ']<|tool_call_end|>' -}}
{%- endmacro -%}

{%- set is_first_system = messages[0]['role'] == 'system' -%}
{%- set loop_messages = messages[1:] if is_first_system else messages -%}
{%- set system_content = format_content(messages[0]['content']) if is_first_system and messages[0]['content'] else '' -%}
{%- if tools -%}
    {%- set tools_ns = namespace(tool_strings=[]) -%}
    {%- for tool in tools -%}
        {%- set tool_data = tool['function'] if tool is mapping and 'function' in tool else tool -%}
        {%- set tool_str = tool_data if tool_data is string else tool_data | tojson -%}
        {%- set tools_ns.tool_strings = tools_ns.tool_strings + [tool_str] -%}
    {%- endfor -%}
    {%- set tools_block = 'List of tools: [' + (tools_ns.tool_strings | join(', ')) + ']' -%}
    {%- set system_content = (system_content + '\n' if system_content else '') + tools_block -%}
{%- endif -%}
{%- if system_content -%}
    {{- '<|im_start|>system\n' + system_content + '<|im_end|>\n' -}}
{%- endif -%}

{%- for message in loop_messages -%}
    {%- if message['role'] == 'assistant' -%}
        {{- '<|im_start|>assistant\n' -}}
        {%- set thinking = message['thinking'] | default(message['reasoning_content'] | default('')) -%}
        {%- if thinking -%}
            {{- '<think>' + thinking + '</think>' -}}
        {%- endif -%}
        {%- if message['tool_calls'] -%}
            {{- render_tool_calls(message['tool_calls']) -}}
        {%- endif -%}
        {{- format_content(message['content']) -}}
        {{- '<|im_end|>\n' -}}
    {%- elif message['role'] == 'tool' -%}
        {{- '<|im_start|>tool\n' + format_tool_content(message['content']) + '<|im_end|>\n' -}}
    {%- else -%}
        {{- '<|im_start|>' + message['role'] + '\n' + format_content(message['content']) + '<|im_end|>\n' -}}
    {%- endif -%}
{%- endfor -%}

{%- if add_generation_prompt -%}
    {{- '<|im_start|>assistant\n' -}}
    {%- if enable_thinking | default(false) -%}
        {{- '<think>\n' -}}
    {%- endif -%}
{%- endif -%}
