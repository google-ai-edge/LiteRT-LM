"""Repository rules to resolve Android SDK/NDK environment variables and stub TF Android config."""

def _first_non_empty_env(ctx, names):
    for name in names:
        val = ctx.getenv(name)
        if val and val.strip():
            cleaned = val.strip()
            if ctx.os.name.lower().startswith("windows"):
                cleaned = cleaned.replace("\\", "/")
            return cleaned
    return ""

def _check_android_ndk_env_impl(ctx):
    ndk_path = _first_non_empty_env(ctx, ["ANDROID_NDK_HOME", "ANDROID_NDK_ROOT"])
    sdk_path = _first_non_empty_env(ctx, ["ANDROID_HOME", "ANDROID_SDK_ROOT"])
    if not sdk_path:
        # TensorFlow's configure uses ANDROID_SDK_HOME for the SDK root, but for
        # Android tools it is the parent of the `.android` user directory, so
        # only take it when it holds an SDK.
        sdk_home = _first_non_empty_env(ctx, ["ANDROID_SDK_HOME"])
        if sdk_home and ctx.path(sdk_home + "/platforms").exists:
            sdk_path = sdk_home
    ndk_home_is_set = bool(ndk_path)

    content = "\n".join([
        "# Generated by android_ndk_env.bzl",
        "ANDROID_NDK_HOME_IS_SET = %s" % ("True" if ndk_home_is_set else "False"),
        "ANDROID_NDK_PATH = %s" % repr(ndk_path),
        "ANDROID_SDK_PATH = %s" % repr(sdk_path),
        "",
    ])
    ctx.file("current_android_ndk_env.bzl", content = content)

    # Dummy BUILD file so "@android_ndk_env//:all" is a valid fallback target.
    ctx.file("BUILD", content = "")

check_android_ndk_env = repository_rule(
    implementation = _check_android_ndk_env_impl,
    local = True,
    environ = [
        "ANDROID_HOME",
        "ANDROID_NDK_HOME",
        "ANDROID_NDK_ROOT",
        "ANDROID_SDK_HOME",
        "ANDROID_SDK_ROOT",
    ],
)

def _stub_local_config_android_impl(ctx):
    ctx.file("BUILD", content = "")
    ctx.file(
        "android.bzl",
        content = "def android_workspace():\n    pass\n",
    )

stub_local_config_android = repository_rule(
    doc = (
        "Pre-declares a no-op @local_config_android before tf_workspace1() so " +
        "tf_workspace0()'s android_workspace() does not instantiate legacy " +
        "native.android_sdk_repository / native.android_ndk_repository rules."
    ),
    implementation = _stub_local_config_android_impl,
)
