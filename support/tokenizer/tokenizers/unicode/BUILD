# Unicode support for the C++ port of the HuggingFace `tokenizers` crate:
# ports of the `unicode-normalization` (+ `unicode_normalization_alignments`),
# `unicode_categories` and `unicode-segmentation` (graphemes) Rust crates plus
# the Rust standard library `char` predicates the tokenizers crate uses. The
# `*_tables.{h,cc}` and `*_test_data.h` files are generated by gen_tables.py
# from the Rust table sources; do not edit them by hand.

# [Google-internal load of `cc_library`]
# [Google-internal load of `cc_test`]

package(
    default_hdrs_check = "strict",
    default_visibility = [
        "//visibility:public",
    ],
)

licenses(["notice"])

exports_files(["gen_tables.py"])

cc_library(
    name = "utf8_chars",
    hdrs = ["utf8_chars.h"],
    visibility = ["//visibility:private"],
    deps = ["@com_google_absl//absl/strings:string_view"],
)

cc_library(
    name = "normalization",
    srcs = [
        "normalization.cc",
        "normalization_tables.cc",
    ],
    hdrs = [
        "normalization.h",
        "normalization_tables.h",
    ],
    deps = [
        ":utf8_chars",
        "@com_google_absl//absl/container:inlined_vector",
        "@com_google_absl//absl/functional:function_ref",
        "@com_google_absl//absl/strings:string_view",
        "@com_google_absl//absl/types:span",
    ],
)

cc_test(
    name = "normalization_test",
    srcs = [
        "normalization_test.cc",
        "normalization_test_data.h",
    ],
    data = [
    ],
    deps = [
        ":normalization",
        ":utf8_chars",
        "@com_google_googletest//:gtest_main",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:string_view",
    ],
)

cc_library(
    name = "categories",
    srcs = [
        "categories.cc",
        "categories_tables.cc",
    ],
    hdrs = [
        "categories.h",
        "categories_tables.h",
    ],
    deps = [
        "@com_google_absl//absl/container:inlined_vector",
        "@com_google_absl//absl/types:span",
    ],
)

cc_test(
    name = "categories_test",
    srcs = ["categories_test.cc"],
    deps = [
        ":categories",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_library(
    name = "graphemes",
    srcs = [
        "graphemes.cc",
        "graphemes_tables.cc",
    ],
    hdrs = [
        "graphemes.h",
        "graphemes_tables.h",
    ],
